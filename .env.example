# Copy to .env and fill in real values. PLACEHOLDERS ONLY - no real secrets.
# Elexon BMRS is keyless; there are no API credentials in this project.

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
PERIOD_START=2026-01-01
PERIOD_END=2026-01-31
# Historical day-ahead decision cutoff (UTC, applied to D-1)
DECISION_CUTOFF_HHMM=09:20
# FUELHH fuel filter (WIND, NUCLEAR, CCGT, ...); per-request override: ?fuel_type=
# Only WIND has a WINDFOR forecast; other fuels serve actuals only.
FUEL_TYPE=WIND
CACHE_TTL_SECONDS=3600
ELEXON_TIMEOUT_SECONDS=60
ELEXON_RETRIES=3
# Comma-separated browser origins allowed by CORS. EXTENDS the built-in list
# (localhost:5173 + https://wind-forecast-intelligence-rho.vercel.app) which is
# always allowed even if this is empty or stale.
ALLOWED_ORIGINS=http://localhost:8081

# ---------------------------------------------------------------------------
# Frontend (build-time)
# ---------------------------------------------------------------------------
# same-origin = nginx proxy (Docker). Unset/empty in a production build falls
# back to https://wind-forecast-intelligence-yalb.vercel.app; dev uses the
# Vite proxy. Set to an explicit backend URL only to override.
VITE_API_BASE=
# Docker only: upstream used by the nginx proxy inside the frontend container
BACKEND_URL=http://backend:8000

# ---------------------------------------------------------------------------
# Deployment (placeholders - replace before use)
# ---------------------------------------------------------------------------
# Vercel project name: YOUR-PROJECT-NAME
# Backend public URL:  https://YOUR-BACKEND-HOST.example.com
